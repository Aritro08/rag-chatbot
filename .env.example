# LLM + tool providers
OPENAI_API_KEY=
TAVILY_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Next.js server routes -> FastAPI
FASTAPI_BASE_URL=http://localhost:8000

# FastAPI CORS
# Use comma-separated values in production, e.g. https://your-ui-domain.com
CORS_ORIGINS=*

# Supabase Postgres (preferred) or generic Postgres URL
# Example:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=
# DATABASE_URL=

# pgvector notes
# Ensure extension is enabled in your database: CREATE EXTENSION IF NOT EXISTS vector;
